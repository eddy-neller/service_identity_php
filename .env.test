# Non-sensitive defaults for the isolated test environment.
KERNEL_CLASS='App\Kernel'
APP_ENV=test
APP_DEBUG=0
APP_SECRET=test-secret

MAILER_DSN=null://null
MESSENGER_TRANSPORT_DSN=in-memory://

# Le publisher est remplace par un double sous `when@test` (cf. config/services.yaml), mais le
# conteneur resout quand meme ces variables a la compilation : des valeurs inertes suffisent.
AWS_REGION=eu-west-3
AWS_ENDPOINT=http://localhost:4566
USER_EVENTS_TOPIC_ARN=arn:aws:sns:eu-west-3:000000000000:identity-user-events

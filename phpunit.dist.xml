<?xml version="1.0" encoding="UTF-8"?>

<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
    </php>

    <testsuites>
        <testsuite name="appli.user">
            <directory>tests/Application/Unit/User/UseCase</directory>
            <directory>tests/Application/Unit/User/Service</directory>
        </testsuite>
        <testsuite name="appli.shop">
            <directory>tests/Application/Unit/Shop/UseCase</directory>
        </testsuite>
        <testsuite name="appli.shared">
            <directory>tests/Application/Unit/Shared</directory>
        </testsuite>

        <testsuite name="domain.shared">
            <directory>tests/Domain/SharedKernel/Unit</directory>
        </testsuite>
        <testsuite name="domain.shop">
            <directory>tests/Domain/Shop/Unit</directory>
        </testsuite>
        <testsuite name="domain.user">
            <directory>tests/Domain/User/Unit</directory>
        </testsuite>

        <testsuite name="infra.api_platform">
            <directory>tests/Infrastructure/Unit/ApiPlatform</directory>
        </testsuite>
        <testsuite name="infra.adapter.hasher">
            <directory>tests/Infrastructure/Integration/Adapter/Hasher</directory>
        </testsuite>
        <testsuite name="infra.adapter.storage">
            <directory>tests/Infrastructure/Unit/Adapter/Storage</directory>
        </testsuite>
        <testsuite name="infra.adapter.token">
            <directory>tests/Infrastructure/Unit/Adapter/Token</directory>
        </testsuite>
        <testsuite name="infra.http.shop_service">
            <directory>tests/Infrastructure/Unit/Http/ShopService</directory>
        </testsuite>
        <testsuite name="infra.persist">
            <directory>tests/Infrastructure/Integration/Persistence</directory>
        </testsuite>
        <testsuite name="infra.symfony.command">
            <directory>tests/Infrastructure/Unit/Symfony/Command</directory>
        </testsuite>
        <testsuite name="infra.symfony.event_subscriber">
            <directory>tests/Infrastructure/Unit/Symfony/EventSubscriber</directory>
        </testsuite>
        <testsuite name="infra.symfony.messenger.cqrs">
            <directory>tests/Infrastructure/Unit/Symfony/Messenger/CQRS</directory>
            <directory>tests/Infrastructure/Integration/Symfony/Messenger/CQRS</directory>
        </testsuite>
        <testsuite name="infra.symfony.messenger.event">
            <directory>tests/Infrastructure/Unit/Symfony/Messenger/Event</directory>
            <directory>tests/Infrastructure/Integration/Symfony/Messenger/Event</directory>
        </testsuite>
        <testsuite name="infra.symfony.security">
            <directory>tests/Infrastructure/Unit/Symfony/Security</directory>
        </testsuite>
        <testsuite name="infra.symfony.service.notification">
            <directory>tests/Infrastructure/Unit/Symfony/Service/Notification</directory>
        </testsuite>

        <testsuite name="pres.state.sendmail">
            <directory>tests/Presentation/Unit/State/SendMail</directory>
        </testsuite>
        <testsuite name="pres.state.shared">
            <directory>tests/Presentation/Unit/State/Shared</directory>
        </testsuite>
        <testsuite name="pres.state.shop">
            <directory>tests/Presentation/Unit/State/Shop</directory>
        </testsuite>
        <testsuite name="pres.state.user">
            <directory>tests/Presentation/Unit/State/User</directory>
        </testsuite>

        <testsuite name="api.shop.category">
            <file>tests/Presentation/Api/Shop/CategoryTest.php</file>
        </testsuite>
        <testsuite name="api.shop.product">
            <file>tests/Presentation/Api/Shop/ProductTest.php</file>
        </testsuite>
        <testsuite name="api.user">
            <directory>tests/Presentation/Api/User</directory>
        </testsuite>
    </testsuites>

    <source ignoreSuppressionOfDeprecations="true"
            ignoreIndirectDeprecations="true"
            restrictNotices="true"
            restrictWarnings="true"
    >
        <include>
            <directory>src/Application/Shop</directory>
            <directory>src/Application/User</directory>
            <directory>src/Domain/SharedKernel</directory>
            <directory>src/Domain/Shop</directory>
            <directory>src/Domain/User</directory>
            <directory>src/Infrastructure</directory>
            <directory>src/Presentation</directory>
            <directory>src</directory>
        </include>
        <exclude>
            <directory>src/Application/Shared</directory>
            <directory>src/Infrastructure/DataFixtures</directory>
            <directory suffix="Entity.php">src/Infrastructure/Persistence/Doctrine</directory>
            <directory>src/Infrastructure/EventListener</directory>
            <directory>src/Infrastructure/EventSubscriber</directory>
            <directory>src/Infrastructure/OpenApi</directory>
            <directory>src/Infrastructure/Security/Voter</directory>
            <directory>src/Infrastructure/Service/Helper</directory>
            <directory>src/Presentation/Shared/Adapter</directory>
            <directory>src/Presentation/User/Security</directory>
        </exclude>

        <deprecationTrigger>
            <method>Doctrine\Deprecations\Deprecation::trigger</method>
            <method>Doctrine\Deprecations\Deprecation::delegateTriggerToBackend</method>
            <function>trigger_deprecation</function>
        </deprecationTrigger>
    </source>

    <extensions>
        <bootstrap class="DAMA\DoctrineTestBundle\PHPUnit\PHPUnitExtension" />
    </extensions>
</phpunit>

# Copy this file to .env for local development. Never commit the resulting .env.

###> Application ###
APP_ENV=dev
APP_SECRET=change-me
APP_SHARE_DIR=var/share
APP_TITLE="E.N Shop Service Identity"
APP_VERSION=0.1.0
APP_MAX_LOGIN_ATTEMPTS=5

AVATAR_MAX_SIZE=2097152
AVATAR_MAX_DIMENSION=512
###< Application ###

###> Routing ###
# URLs used when generating links outside an HTTP request.
DEFAULT_URI=http://localhost:8000
DEFAULT_FRONT_URI=http://127.0.0.1:3000
###< Routing ###

###> PostgreSQL 18 ###
# Host/port as seen from the app container. *_EXPOSED_PORT is the port published on the host.
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_EXPOSED_PORT=20902
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_VERSION=18
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?serverVersion=${POSTGRES_VERSION}&charset=utf8"
# The test environment inherits this DSN; Doctrine appends its configured _test suffix.
###< PostgreSQL 18 ###

###> JWT / Authentication ###
# Generate local keys under config/jwt; these paths are resolved by Symfony.
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-me
JWT_TTL=900
JWT_REFRESH_TTL=P30D
###< JWT / Authentication ###

###> Mailer / Mailpit ###
MAILPIT_SMTP_EXPOSED_PORT=20906
MAILPIT_HTTP_EXPOSED_PORT=20907
MAILER_DSN="smtp://mailer:1025"
MAILER_USER=placeholder
MAILER_PASSWORD=change-me
MAILER_PORT=1025
MAILER_TO=no-reply@example.test
MAILER_REPLY=support@example.test
MAILER_URI_FRONT_REGISTER_VALIDATION="${DEFAULT_FRONT_URI}/register/validate"
MAILER_URI_FRONT_RESET_PASSWORD="${DEFAULT_FRONT_URI}/forgot-password/reset"
###< Mailer / Mailpit ###

###> CORS ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< CORS ###

###> Application tokens ###
# ISO 8601 durations consumed by DateInterval.
REGISTER_TOKEN_TTL=P2D
RESET_PASSWORD_TOKEN_TTL=PT15M
###< Application tokens ###

###> Debug ###
# framework.yaml adds the tcp:// scheme.
VAR_DUMPER_SERVER=host.docker.internal:9912
###< Debug ###

###> Stripe ###
# Placeholders only. Put real local keys in .env.
STRIPE_SHOP_SECRET_KEY=sk_test_placeholder
TEST_STRIPE_SHOP_SECRET_KEY=sk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
###< Stripe ###

###> RabbitMQ 4 / Messenger ###
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_EXPOSED_PORT=20908
RABBITMQ_MANAGEMENT_EXPOSED_PORT=20909
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
MESSENGER_TRANSPORT_DSN="amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/%2f/messages"
###< RabbitMQ 4 / Messenger ###

###> Nginx ###
# Front HTTP du conteneur app (php-fpm). C'est l'URL de travail : http://localhost:20900
NGINX_EXPOSED_PORT=20900
###< Nginx ###

###> Varnish 8 ###
VARNISH_EXPOSED_PORT=20901
# Internal URL used by API Platform to send BAN requests to the reverse proxy.
VARNISH_URL="http://varnish"
###< Varnish 8 ###

###> Redis 8 ###
REDIS_EXPOSED_PORT=20903
REDIS_URL="redis://redis:6379"
###< Redis 8 ###

###> Lock ###
# Store Redis obligatoire. La base 1 isole les verrous du cache.
LOCK_DSN="${REDIS_URL}/1"
###< Lock ###

###> Xdebug / PhpStorm ###
# Consumed by docker-compose.yaml (app service), not by Symfony.
# Set XDEBUG_MODE=off to disable the debugger and get the performance back.
XDEBUG_MODE=debug
# Nom du serveur PHP côté PhpStorm (Settings > PHP > Servers) pour le mapping Xdebug.
PHP_IDE_SERVER_NAME=en-shop-api
###< Xdebug / PhpStorm ###

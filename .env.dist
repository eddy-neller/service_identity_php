# Copy this file to .env for local development. Never commit the resulting .env.

###> Application ###
APP_ENV=dev
APP_SECRET=change-me
APP_SHARE_DIR=var/share
APP_TITLE="E.N Shop API"
APP_VERSION=0.1.0
APP_MAX_LOGIN_ATTEMPTS=5

AVATAR_MAX_SIZE=2097152
AVATAR_MAX_DIMENSION=512
###< Application ###

###> Routing ###
# URLs used when generating links outside an HTTP request.
DEFAULT_URI=http://localhost:20900
DEFAULT_FRONT_URI=http://127.0.0.1:4000
###< Routing ###

###> PostgreSQL 18 ###
# Host-side connection settings. POSTGRES_PORT is also the published Docker port.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=20902
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_VERSION=18
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?serverVersion=${POSTGRES_VERSION}&charset=utf8"
# The test environment inherits this DSN; Doctrine appends its configured _test suffix.
###< PostgreSQL 18 ###

###> JWT / Authentication ###
# Generate local keys under config/jwt; these paths are resolved by Symfony.
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-me
JWT_TTL=900
JWT_REFRESH_TTL=P30D
###< JWT / Authentication ###

###> Mailer / Mailpit ###
MAILPIT_SMTP_PORT=20906
MAILPIT_HTTP_PORT=20907
MAILER_DSN="smtp://127.0.0.1:${MAILPIT_SMTP_PORT}"
MAILER_USER=placeholder
MAILER_PASSWORD=change-me
MAILER_PORT=${MAILPIT_SMTP_PORT}
MAILER_TO=no-reply@example.test
MAILER_REPLY=support@example.test
MAILER_URI_FRONT_REGISTER_VALIDATION="${DEFAULT_FRONT_URI}/register/validate"
MAILER_URI_FRONT_RESET_PASSWORD="${DEFAULT_FRONT_URI}/reset-password"
###< Mailer / Mailpit ###

###> CORS ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< CORS ###

###> Application tokens ###
# ISO 8601 durations consumed by DateInterval.
REGISTER_TOKEN_TTL=P2D
RESET_PASSWORD_TOKEN_TTL=PT15M
###< Application tokens ###

###> Debug / Lock ###
# framework.yaml adds the tcp:// scheme.
VAR_DUMPER_SERVER=127.0.0.1:9912
LOCK_DSN=flock
###< Debug / Lock ###

###> Stripe ###
# Placeholders only. Put real local keys in .env.
STRIPE_SHOP_SECRET_KEY=sk_test_placeholder
TEST_STRIPE_SHOP_SECRET_KEY=sk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
###< Stripe ###

###> RabbitMQ 4 / Messenger ###
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=20908
RABBITMQ_MANAGEMENT_PORT=20909
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
MESSENGER_TRANSPORT_DSN="amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/%2f/messages"
###< RabbitMQ 4 / Messenger ###

###> Varnish 8 ###
VARNISH_PORT=20901
VARNISH_URL="http://127.0.0.1:${VARNISH_PORT}"
###< Varnish 8 ###

###> Redis 8 ###
REDIS_PORT=20903
REDIS_URL="redis://127.0.0.1:${REDIS_PORT}"
###< Redis 8 ###
